# ===================================================================
# kindle-oasis-minivmac — .gitignore
#
# Tracked:             source code, build scripts, documentation,
#                      KUAL extension files, config templates.
# Ignored:             proprietary ROM/disks, device-extracted sysroots,
#                      downloaded toolchains, build artifacts.
# ===================================================================

# --- Build artifacts ---
minivmac-src/setup_t
minivmac-src/setup.sh
minivmac-src/bld/
minivmac-src/cfg/
minivmac-src/minivmac
minivmac-src/minivmac-36.04.src.tgz
minivmac-src/compat-glibc.o
minivmac-src/Makefile
kindle-touch/touch
wario-companion/companion
wario-companion/wario-companion*
hello-c/hello
**/*.o

# Rust build directories
/*/target
/**/target

# --- Device-extracted sysroots (proprietary Amazon firmware) ---
oasis-sysroot/
pw5-sysroot/
tools/pw5-build-sysroot/

# --- Downloaded toolchains and build dependencies (regenerated by setup-pw5.sh) ---
tools/

# --- Proprietary Apple ROM and disk images ---
*.rom
*.img
*.dsk

# --- Deploy bundle (contains built binaries + proprietary ROMs/disks) ---
deploy/

# --- User notes / temp files ---
note.txt
*.jpg
*.png

# --- macOS ---
.DS_Store